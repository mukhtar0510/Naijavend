{
  "name": "idevtenancy",
  "private": true,
  "version": "0.1.0",
  "description": "Naijavend — storefronts for Nigerian sellers. Store + service builder with AI-assisted setup, ratings, map presence, rankings, and WhatsApp storefront links.",
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:storefront": "pnpm --filter @idevtenancy/storefront dev",
    "dev:seller": "pnpm --filter @idevtenancy/seller start",
    "build:storefront": "pnpm --filter @idevtenancy/storefront build",
    "build:seller": "pnpm --filter @idevtenancy/seller build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "next": "^14.2.0",
    "typescript": "^5.6.0"
  }
}
