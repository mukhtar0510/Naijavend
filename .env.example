# iDevTenancy environment variables — names only, never commit real values.

# Supabase (shared by storefront + seller app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI — get a free API key at https://aistudio.google.com/apikey (Google account,
# no card needed; the free tier covers these draft features comfortably).
# Set it here for local dev AND in the Vercel project's Environment Variables
# for production. Without a key every AI surface falls back to the built-in
# dummy provider, so nothing breaks either way.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Payments — mock provider needs no key. Real Paystack keys go here when wired:
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
