# iDevTenancy environment variables — names only, never commit real values.

# Supabase (shared by storefront + seller app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI — get a free API key at https://aistudio.google.com/apikey (Google account,
# no card needed; the free tier covers these draft features comfortably).
# Set it here for local dev AND in the Vercel project's Environment Variables
# for production. Without a key every AI surface falls back to the built-in
# dummy provider, so nothing breaks either way.
GEMINI_API_KEY=
# Optional: override the Gemini text model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# AI image generation — uses a Gemini image-generation model via the same
# GEMINI_API_KEY. Set GEMINI_IMAGE_MODEL when the current Gemini image model id
# differs from the text model id (e.g. gemini-2.0-flash-exp/image-generation or
# the current Gemini image model id). If unset, the text model id is reused.
GEMINI_IMAGE_MODEL=

# WhatsApp Cloud API — optional, enables sending generated images + captions to
# the seller's own WhatsApp business number from AI Studio. The Cloud API is free
# for the first 1,000 service conversations/month, then usage-based.
#
# One WhatsApp Business Account usually has one Cloud API phone id. For a
# marketplace with many sellers, you can either:
#   - use one platform-level token/phone id (every store sends from the same
#     business number), or
#   - set WHATSAPP_PHONE_ID_BY_STORE to a JSON object mapping store id → phone id
#     if you have multiple WhatsApp Business Accounts.
#
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PHONE_ID_BY_STORE=
# Payments — mock provider needs no key. Real Paystack keys go here when wired:
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
